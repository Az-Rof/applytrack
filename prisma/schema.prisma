// ApplyTrack AI — Prisma schema
// Run: npm run db:push (or npm run db:migrate) after setting DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User account — identified by `id`, signed in with email + password.
/// Each user owns their applications and sessions.
/// (Before 12 Nov 2026 users were "workspaces" identified by a short code;
/// that code auth was removed — see README "Auth: email + password".)
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  /// scrypt hash from `src/lib/password.ts` (`scrypt:<salt>:<hash>`).
  /// Null only for legacy rows created before password auth; those accounts
  /// cannot log in until a password is set (register a new account).
  passwordHash String?
  name         String?
  /// Auto-reject rule: in-progress applications with no status change for
  /// more than this many days are automatically marked REJECTED (null = off).
  autoRejectDays Int?
  createdAt    DateTime      @default(now())
  applications Application[]
  sessions     Session[]
}

/// Server-side login session. The browser cookie (and the extension) holds
/// the raw token; only its SHA-256 hash is stored here, so a database leak
/// does not expose live sessions. Expired sessions are ignored (and can be
/// pruned).
model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

/// Application status lifecycle (PRD §6 Feature 3)
enum ApplicationStatus {
  APPLIED
  HR_SCREENING
  INTERVIEW
  TECHNICAL_TEST
  USER_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Where the application was submitted from.
enum ApplicationSource {
  MANUAL
  EXTENSION
  IMPORT
}

model Application {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle      String
  companyName   String
  platform      String
  location      String?
  jobUrl        String?           @db.Text
  employmentType String?
  salary        String?
  appliedAt     DateTime          @default(now())
  status        ApplicationStatus @default(APPLIED)
  notes         String?           @db.Text
  source        ApplicationSource @default(MANUAL)
  /// The application's ID on its source platform (e.g. Glints application
  /// UUID). Set by platform syncs so repeats are idempotent even when the
  /// platform job URL differs from the URL the extension captured.
  externalId    String?

  /// Job-posting-level signal mirrored from the platform (does NOT change the
  /// application status): Glints closed the posting ("Loker Dihapus" /
  /// "Tidak lagi menerima lamaran") — e.g. because it was flagged as fraud.
  jobClosed     Boolean  @default(false)
  jobClosedAt   DateTime?
  /// Raw platform flag, e.g. Glints `fraudReportFlag: "VERIFIED_SCAM_FRAUD"`.
  jobFlag       String?

  lastStatusChangeAt DateTime @default(now())
  lastFollowUpAt     DateTime?
  archived           Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  statusHistory StatusHistory[]
  reminders     Reminder[]

  @@unique([userId, jobUrl])
  @@index([userId, appliedAt])
  @@index([userId, status])
  @@index([userId, platform])
  @@index([userId, platform, externalId])
}

model StatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  note          String?
  changedAt     DateTime          @default(now())

  @@index([applicationId, changedAt])
}

/// Follow-up reminders (PRD §6 Feature 4)
enum ReminderType {
  FOLLOW_UP
  INTERVIEW_PREP
  CUSTOM
}

enum ReminderStatus {
  PENDING
  DONE
  DISMISSED
}

model Reminder {
  id            String         @id @default(uuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ReminderType   @default(FOLLOW_UP)
  status        ReminderStatus @default(PENDING)
  dueAt         DateTime
  message       String
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([status, dueAt])
  @@index([applicationId])
}

/// Generated AI reports (PRD V3: weekly report / insights)
enum ReportType {
  WEEKLY
  ON_DEMAND
}

model Report {
  id        String     @id @default(uuid())
  userId    String
  type      ReportType @default(ON_DEMAND)
  title     String
  content   String     @db.Text
  metadata  Json?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
}
