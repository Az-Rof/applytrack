# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/applytrack?schema=public"

# Chrome extension -> API authentication
EXTENSION_API_KEY="change-me"

# Protects POST /api/cron/reminders (leave empty for local dev)
CRON_SECRET=""

# OpenAI (optional). If empty, the agent falls back to rule-based analysis.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
