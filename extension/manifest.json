{
  "manifest_version": 3,
  "name": "ApplyTrack — Auto Capture",
  "version": "1.0.0",
  "description": "Automatically captures job applications from Glints, LinkedIn, Kalibrr and Indeed.",
  "permissions": ["storage", "activeTab", "scripting", "notifications", "cookies"],
  "host_permissions": [
    "*://*.glints.com/*",
    "*://*.linkedin.com/*",
    "*://*.kalibrr.com/*",
    "*://*.indeed.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyTrack"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.glints.com/*",
        "*://*.linkedin.com/*",
        "*://*.kalibrr.com/*",
        "*://*.indeed.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
